# API key for optional AI summaries.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PROVIDER=gemini
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# External RAG is opt-in. Discord content stays local unless explicitly allowed.
RAG_ENABLED=false
RAG_PROVIDER=gemini
RAG_INCLUDE_DISCORD_DATA=false

# SQLite is the primary runtime store. Relative paths are resolved from codebase/.
QUALITY_HUB_DB_PATH=data/quality_hub.db

# Discord data sync.
# Enable Message Content Intent if message content is empty.
# Invite the bot into the server and grant View Channel + Read Message History.
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here
DISCORD_SYNC_LIMIT=50
DISCORD_SYNC_INTERVAL_SECONDS=120
DISCORD_SYNC_WITH_AI=false
TOP_K_RESULTS=3

# Use this instead of DISCORD_CHANNEL_ID when syncing multiple channels/forums/threads.
# DISCORD_CHANNEL_IDS=channel_id_1,channel_id_2,channel_id_3
